# 复制为 .env 后按需改。密钥绝不进仓: OSS_AK_ID / OSS_AK_SECRET 从进程环境或
# 用户注册表 HKCU\Environment 读（与同舟/凡梦同一口径）。
OSS_BUCKET=testfqs
OSS_REGION=oss-cn-hangzhou
OSS_PREFIX=sdxcloud/minigames
# 桶配了自定义域名才填，否则用默认域名（默认域名对 HTML 强制下载，所以首页不走 OSS）
# OSS_PUBLIC_BASE=

# 本机现发端口。三处必须一致: tools/serve-web.mjs、src-tauri 探测口、Cloudflare 子域名路由。
MINIGAMES_SERVE_PORT=8770